{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "PublicBaseUrl": "",

  "Admin": {
    "Pin": ""
  },
  "Tank": {
    "PopulationCap": 30
  },
  "Moderation": {
    "AutoApprove": false,
    "MaxPending": 100,
    "ProfanityListPath": "profanity.txt"
  },
  "RateLimit": {
    "SecondsPerDevice": 30,
    "RequireConnection": true,
    "MaxPerIpPerMinute": 20
  },
  "Upload": {
    "MaxBytes": 262144,
    "MaxDimension": 512,
    "MaxNameLength": 20
  },
  "Storage": {
    "DataPath": "../../data"
  },
  "Snapshots": {
    "IntervalMinutes": 5,
    "IncludeOverlay": true
  },
  "Display": {
    "CreditLine": "Built by Computer Programming with C#, ASP.NET Core, and SignalR."
  },
  "Programs": [
    {
      "Label": "Computer Programming (AAT degree)",
      "Url": "https://www.cptc.edu/programs/computer-programming"
    },
    {
      "Label": "B.S. in Computer Science and Cyber-Physical Software Engineering",
      "Url": "https://www.cptc.edu/programs/BSCompSci"
    }
  ]
}
