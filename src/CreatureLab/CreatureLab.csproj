<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CreatureLab</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Word list for the name filter; loaded at startup, editable without recompiling. -->
    <None Update="profanity.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Local overrides (admin PIN, etc.). Never committed; see README. -->
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
